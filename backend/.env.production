# PRODUCTION ENVIRONMENT VARIABLES
# Copy this to .env and fill in real values

# Django Settings
DEBUG=False
SECRET_KEY=your-super-secret-key-change-this-to-something-secure
ALLOWED_HOSTS=resqnav.com,www.resqnav.com,api.resqnav.com
ENVIRONMENT=production

# Database (PostgreSQL)
DATABASE_URL=postgresql://resqnav_user:secure_password@db.resqnav.com:5432/resqnav_prod

# Redis Cache
REDIS_URL=redis://:password@redis.resqnav.com:6379/0

# Email Service (SendGrid)
EMAIL_BACKEND=anymail.backends.sendgrid.EmailBackend
SENDGRID_API_KEY=SG.your_sendgrid_key_here
EMAIL_HOST_USER=noreply@resqnav.com
EMAIL_HOST_PASSWORD=SG.your_sendgrid_key_here
DEFAULT_FROM_EMAIL=ResQNav <noreply@resqnav.com>

# SMS Service (MSG91)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=RESQNV
MSG91_ROUTE=4

# AWS S3 Storage
USE_S3=True
AWS_STORAGE_BUCKET_NAME=resqnav-prod
AWS_S3_REGION_NAME=us-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Sentry Error Tracking
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# CORS Settings
CORS_ALLOWED_ORIGINS=https://resqnav.com,https://www.resqnav.com,https://app.resqnav.com

# Frontend URL
FRONTEND_URL=https://resqnav.com

# Security
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/resqnav/django.log

# Celery Task Queue
CELERY_BROKER_URL=redis://:password@redis.resqnav.com:6379/1
CELERY_RESULT_BACKEND=redis://:password@redis.resqnav.com:6379/2
