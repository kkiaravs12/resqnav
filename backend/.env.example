# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (for production, use PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/resqnav

# MSG91 SMS Service (Get from https://msg91.com/)
MSG91_AUTH_KEY=your-msg91-auth-key-here
MSG91_SENDER_ID=RESQNV
MSG91_ROUTE=4

# Twilio (Alternative SMS Service)
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=+1234567890

# Email Settings (SendGrid for production, Console for development)
# For development: Uses console backend (prints to terminal)
# For production: Configure SendGrid API key

# Development (Console Email Backend - prints to terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Production (SendGrid Backend)
# EMAIL_BACKEND=anymail.backends.sendgrid.EmailBackend
# EMAIL_HOST_PASSWORD=SG.your_sendgrid_api_key_here

# Email Configuration
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
DEFAULT_FROM_EMAIL=ResQNav <noreply@resqnav.com>

# SendGrid Setup (Production):
# 1. Create account at https://sendgrid.com/
# 2. Generate API key: Settings > API Keys > Create API Key
# 3. Set EMAIL_BACKEND=anymail.backends.sendgrid.EmailBackend
# 4. Set EMAIL_HOST_PASSWORD to your SendGrid API key

# Error Tracking (Sentry)
# For production error monitoring and alerting
# 1. Create account at https://sentry.io/
# 2. Create new Django project
# 3. Copy DSN from project settings
# 4. Set SENTRY_DSN in production environment
# Note: Sentry is automatically disabled when DEBUG=True

# Development (no error tracking)
# SENTRY_DSN=

# Production (Sentry error tracking)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Error Tracking (Sentry)
# For production error monitoring and alerting
# 1. Create account at https://sentry.io/
# 2. Create new Django project
# 3. Copy DSN from project settings
# 4. Set SENTRY_DSN in production environment
# Note: Sentry is automatically disabled when DEBUG=True

# Development (no error tracking)
# SENTRY_DSN=

# Production (Sentry error tracking)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
