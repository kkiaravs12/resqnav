# ─────────────────────────────────────────────────────────────────────
# ResQNav Production Environment Configuration
# ─────────────────────────────────────────────────────────────────────

# Django Core
DEBUG=False
SECRET_KEY=django-insecure-production-key-change-in-production-12345abcdef!@#$%^
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com,www.yourdomain.com

# Database (PostgreSQL)
DATABASE_URL=postgresql://resqnav:securepass123@db:5432/resqnav
POSTGRES_DB=resqnav
POSTGRES_USER=resqnav
POSTGRES_PASSWORD=securepass123

# Redis Cache & Rate Limiting
REDIS_URL=redis://:redispass123@redis:6379/0
REDIS_PASSWORD=redispass123

# Email Configuration (SendGrid)
EMAIL_BACKEND=anymail.backends.sendgrid.EmailBackend
SENDGRID_API_KEY=SG.YOUR_SENDGRID_API_KEY_HERE
DEFAULT_FROM_EMAIL=noreply@resqnav.com
SUPPORT_EMAIL=support@resqnav.com

# SMS Configuration (MSG91 + Twilio)
MSG91_AUTH_KEY=YOUR_MSG91_AUTH_KEY_HERE
MSG91_ROUTE=4
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=+1234567890

# AWS S3 File Storage
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
AWS_STORAGE_BUCKET_NAME=resqnav-production
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=None
USE_S3=True

# Error Tracking (Sentry)
SENTRY_DSN=https://YOUR_SENTRY_DSN@sentry.io/YOUR_PROJECT_ID
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# JWT Authentication
SIMPLE_JWT_ACCESS_TOKEN_LIFETIME=3600
SIMPLE_JWT_REFRESH_TOKEN_LIFETIME=2592000

# CORS (Specific origins in production)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://app.yourdomain.com

# Security
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_SECURITY_POLICY=default-src 'self'

# Rate Limiting (requests per minute/hour)
RATE_LIMIT_AUTH=5/m
RATE_LIMIT_GENERAL=1000/h
RATE_LIMIT_EMERGENCY=10/m

# Logging
LOG_LEVEL=INFO
